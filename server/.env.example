# Copy to `.env` and fill in. Never commit the real `.env`.

# --- Server ---
PORT=4000
# 'production' turns on the secure, cross-site session cookie and hides
# internal error messages. Leave unset (or 'development') locally.
NODE_ENV=development

# Comma-separated frontend origins allowed to call the API with credentials.
# Exact match: scheme + host + port, no trailing slash, no path.
# Production example: https://studysphere-edtech.vercel.app
CORS_ORIGINS=http://localhost:5173

# Frontend base URL used in password-reset emails ("/update-password/<token>"
# is appended). No trailing slash.
FRONTEND_URL_UPDATE_PASSWORD=http://localhost:5173

# --- Database ---
MONGODB_URL=mongodb://localhost:27017/studysphere

# --- Auth ---
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# --- Mail (SMTP) ---
# For Gmail use smtp.gmail.com with an App Password, not the account password.
MAIL_HOST=smtp.gmail.com
EMAIL_USER=
EMAIL_PASS=

# --- Cloudinary (thumbnails, profile images, lecture videos) ---
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
FOLDER_NAME=studysphere

# --- Razorpay ---
# RAZORPAY_KEY must match the frontend's VITE_RAZORPAY_KEY.
RAZORPAY_KEY=
RAZORPAY_SECRET=
