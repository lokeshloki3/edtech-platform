# Backend API base URL or actual backend server URL. This is used to make API requests from the frontend.
VITE_BASE_URL=http://localhost:4000/api/v1

# Razorpay publishable key
VITE_RAZORPAY_KEY=

# 'true' on staging/UAT only: noindex, nofollow site-wide and robots.txt blocks
# every path. In production only the dashboard and auth routes are blocked.
VITE_STAGING=false
